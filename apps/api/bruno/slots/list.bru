meta {
  name: list slots
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/slots?craft=painting
  body: none
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
}

params:query {
  craft: painting
}

vars:post-response {
  craftsmanId: res.body[0]?.craftsman.id
}

assert {
  res.status: eq 200
  res.body: isArray
  res.body[0].craftsman.craft: eq painting
}
