{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "local-craftsmen-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable only through the web Worker's service binding.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BETTER_AUTH_URL": "https://craftsmen.quantum-amplitude.tech",
    "WEB_ORIGIN": "https://craftsmen.quantum-amplitude.tech"
  },
  // Local: .env.local. Production: `wrangler secret put <NAME>` for each.
  "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace this placeholder with the production Hyperdrive configuration ID before deploy.
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://postgres:postgres@localhost:5432/craftsmen"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
