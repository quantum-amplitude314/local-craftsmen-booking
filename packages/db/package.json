{
  "name": "@local-craftsmen/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./migrate": "./src/migrate.ts",
    "./test-db": "./src/test-db.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=.env.test test",
    "db:generate": "bun --env-file=.env.local drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:seed:reference": "bun --env-file=.env.local src/seed-reference.ts",
    "db:seed:test": "bun --env-file=.env.local src/seed-test.ts",
    "db:clear": "bun --env-file=.env.local src/clear.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@local-craftsmen/config": "workspace:*",
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10"
  }
}
