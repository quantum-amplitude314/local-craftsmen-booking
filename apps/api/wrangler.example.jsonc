{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "local-craftsmen-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable only through the web Worker's service binding.
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BETTER_AUTH_URL": "https://craftsmen.quantum-amplitude.tech",
    "WEB_ORIGIN": "https://craftsmen.quantum-amplitude.tech",
    "CONTACT_SENDER_EMAIL": "no-reply@mail.example.com",
    "CONTACT_RECIPIENT_EMAIL": "contact@example.com"
  },
  "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "RESEND_API_KEY"] },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Replace this placeholder with the production Hyperdrive configuration ID before deploy.
      "id": "00000000000000000000000000000000"
    }
  ],
  "env": {
    "preview": {
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:3001",
        "WEB_ORIGIN": "http://localhost:3000",
        "CONTACT_SENDER_EMAIL": "no-reply@mail.example.com",
        "CONTACT_RECIPIENT_EMAIL": "contact@example.com"
      },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "RESEND_API_KEY"] },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000",
          "localConnectionString": "postgres://user:password@preview-host/database"
        }
      ]
    },
    "test": {
      "vars": {
        "BETTER_AUTH_URL": "http://localhost:3001",
        "WEB_ORIGIN": "http://localhost:3000",
        "CONTACT_SENDER_EMAIL": "no-reply@example.com",
        "CONTACT_RECIPIENT_EMAIL": "contact@example.com"
      },
      "secrets": { "required": ["BETTER_AUTH_SECRET", "TURNSTILE_SECRET_KEY", "RESEND_API_KEY"] },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000",
          "localConnectionString": "postgres://postgres:postgres@localhost:5432/craftsmen_test"
        }
      ]
    }
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
