{
  "name": "@local-craftsmen/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot --env-file=.env.local --env-file=../../packages/db/.env.local src/bun.ts",
    "dev:preview": "wrangler dev --env-file .env.local --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types --env-file .env.example",
    "typecheck": "bun run cf-typegen && tsc --noEmit",
    "test": "vitest run && bun run test:auth",
    "test:auth": "bun --env-file=.env.test --env-file=../../packages/db/.env.test test test/auth.integration.test.ts"
  },
  "dependencies": {
    "@local-craftsmen/application": "workspace:*",
    "@local-craftsmen/contracts": "workspace:*",
    "@local-craftsmen/db": "workspace:*",
    "@orpc/openapi": "^1.15.1",
    "@orpc/server": "^1.15.1",
    "better-auth": "^1.7.5",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.2.1",
    "@local-craftsmen/config": "workspace:*",
    "@types/bun": "latest",
    "@types/node": "^26.6.2",
    "drizzle-orm": "^0.45.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.136.1"
  }
}
