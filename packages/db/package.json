{
  "name": "@local-craftsmen/db",
  "version": "1.2.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./migrate": "./src/migrate.ts",
    "./test-db": "./src/test-db.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=.env.test test",
    "db:generate": "bun --env-file=.env.development drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.development drizzle-kit migrate",
    "db:migrate:preview": "bun --env-file=.env.preview drizzle-kit migrate",
    "db:migrate:production": "bun --env-file=.env.production drizzle-kit migrate",
    "db:seed:reference": "bun --env-file=.env.development src/seed-reference.ts",
    "db:seed:reference:preview": "bun --env-file=.env.preview src/seed-reference.ts",
    "db:seed:reference:production": "bun --env-file=.env.production src/seed-reference.ts",
    "db:clear": "bun --env-file=.env.development src/clear.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@local-craftsmen/config": "workspace:*",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11"
  },
  "trustedDependencies": []
}
