{
  "name": "@local-craftsmen/web",
  "version": "1.2.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "bun --env-file=.env.preview run opennextjs-cloudflare build --env preview && opennextjs-cloudflare preview --env preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "bun run cf-typegen && next typegen && tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@local-craftsmen/contracts": "workspace:*",
    "@orpc/client": "^1.15.4",
    "@orpc/contract": "^1.15.4",
    "@orpc/openapi-client": "^1.15.4",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@local-craftsmen/config": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  },
  "trustedDependencies": []
}
