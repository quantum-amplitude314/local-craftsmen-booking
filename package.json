{
  "name": "local-craftsmen",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint-fix": "biome check --write .",
    "api:dev": "bun run --cwd apps/api dev",
    "api:test": "bun run --cwd apps/api test:api",
    "db:up": "podman compose up -d",
    "db:down": "podman compose down",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:seed": "bun run --cwd packages/db db:seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
