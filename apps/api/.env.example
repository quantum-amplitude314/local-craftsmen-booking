# Copy to .env.local. Read by the Bun entry (`dev`) and by `wrangler dev` (`dev:preview`);
# validated by src/env.ts. Production: `vars` in wrangler.jsonc, secrets via `wrangler secret put`.

# Secret, at least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=test-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000

# Bun entry only, defaults to 3001. The Bun entry takes DATABASE_URL from packages/db/.env.local.
# PORT=3001

# Secret. Turnstile test secret, always passes (pairs with a 1x test site key in apps/web/.env.local):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Always fails, so the API rejects every token:
# TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
# Answers "token already spent" (timeout-or-duplicate):
# TURNSTILE_SECRET_KEY=3x0000000000000000000000000000000AA
