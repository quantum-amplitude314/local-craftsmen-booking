{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "local-craftsmen-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "craftsmen.quantum-amplitude.tech", "custom_domain": true }],
  "workers_dev": false,
  "vars": {
    "WRANGLER_BINDING": "on",
    "WEB_ORIGIN": "https://craftsmen.quantum-amplitude.tech"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "API", "service": "local-craftsmen-api" },
    { "binding": "WORKER_SELF_REFERENCE", "service": "local-craftsmen-web" }
  ],
  "env": {
    "development": {
      "routes": [],
      "vars": {
        "WRANGLER_BINDING": "off",
        "API_URL": "http://localhost:3001",
        "WEB_ORIGIN": "http://localhost:3000"
      },
      "services": [
        { "binding": "API", "service": "local-craftsmen-api" },
        { "binding": "WORKER_SELF_REFERENCE", "service": "local-craftsmen-web-development" }
      ]
    },
    "preview": {
      "routes": [],
      "vars": {
        "WRANGLER_BINDING": "on",
        "WEB_ORIGIN": "http://localhost:3000"
      },
      "services": [
        { "binding": "API", "service": "local-craftsmen-api-preview" },
        { "binding": "WORKER_SELF_REFERENCE", "service": "local-craftsmen-web-preview" }
      ]
    }
  },
  "observability": { "enabled": true }
}
