{
  "name": "local-craftsmen",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint-fix": "biome check --write .",
    "web:dev": "bun run --cwd apps/web dev",
    "api:dev": "bun run --cwd apps/api dev",
    "db:up": "podman compose up -d",
    "db:down": "podman compose down",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:seed:reference": "bun run --cwd packages/db db:seed:reference",
    "db:seed:test": "bun run --cwd packages/db db:seed:test",
    "db:clear": "bun run --cwd packages/db db:clear"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "turbo": "^2.11.3",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": []
}
