# `next dev` runs without wrangler and reads these instead of wrangler.jsonc vars.
WRANGLER_BINDING=off
API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Turnstile test site key, always passes:
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Always blocks:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
# Forces an interactive challenge:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF
