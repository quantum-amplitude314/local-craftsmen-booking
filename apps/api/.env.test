# Committed test values for `test:auth`, validated by src/env.ts; none of them are secrets.
BETTER_AUTH_SECRET=test-secret-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Turnstile test secret, always passes.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Dummy token the Turnstile test site keys produce; only test secrets accept it. A real token needs a
# browser solving the widget and is single-use for 300 s, so the auth tests send this one.
TURNSTILE_TEST_TOKEN=XXXX.DUMMY.TOKEN.XXXX
