{
  "name": "@local-craftsmen/api",
  "version": "1.2.2",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "bun --hot --env-file=.env.development --env-file=../../packages/db/.env.development src/bun.ts",
    "preview": "wrangler dev --env preview --env-file .env.preview --port 3001",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "bun run cf-typegen && tsc --noEmit",
    "test": "bun --env-file=.env.test run vitest run && bun run test:auth",
    "test:auth": "bun --env-file=.env.test --env-file=../../packages/db/.env.test test test/auth.integration.test.ts"
  },
  "dependencies": {
    "@local-craftsmen/application": "workspace:*",
    "@local-craftsmen/contracts": "workspace:*",
    "@local-craftsmen/db": "workspace:*",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "hono": "^4.13.13",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.7",
    "@local-craftsmen/config": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "drizzle-orm": "catalog:",
    "vitest": "^4.1.11",
    "wrangler": "catalog:"
  },
  "trustedDependencies": []
}
