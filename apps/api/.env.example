# Generate a local secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
# Turnstile test secret, always passes. Replace with the real secret before going live.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Always fails, so the API rejects every token:
# TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA
# Dummy token produced by the Turnstile test site keys; the auth tests send it.
TURNSTILE_TEST_TOKEN=XXXX.DUMMY.TOKEN.XXXX
