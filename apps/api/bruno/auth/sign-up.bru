meta {
  name: sign up customer
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/sign-up/email
  body: json
  auth: none
}

headers {
  Origin: http://localhost:3000
  x-captcha-response: XXXX.DUMMY.TOKEN.XXXX
}

body:json {
  {
    "name": "Bruno Customer",
    "email": "{{email}}",
    "password": "correct-horse-battery",
    "role": "customer"
  }
}

script:pre-request {
  bru.setVar("email", `bruno-${Date.now()}@example.com`);
}

script:post-response {
  const setCookie = [res.getHeader("set-cookie")].flat().filter(Boolean);
  bru.setVar("sessionCookie", setCookie.map((header) => header.split(";")[0]).join("; "));
}

assert {
  res.status: eq 200
}
