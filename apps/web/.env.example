# Copy to .env.local. Build-time only: Next inlines NEXT_PUBLIC_* into the bundle, so a change
# needs a rebuild. Runtime values live in .dev.vars (see .dev.vars.example).

# Turnstile test site key, always passes, visible (pairs with the 1x test secret in apps/api/.env.local):
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Always fails, visible:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=2x00000000000000000000AB
# Forces an interactive challenge:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=3x00000000000000000000FF
# Real key. Switch before `deploy`; the production API has the real secret:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<real-site-key>
