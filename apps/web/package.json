{
  "name": "@local-craftsmen/web",
  "version": "1.2.7",
  "private": true,
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build:worker": "./scripts/build-worker.sh",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "bun --env-file=.env.preview run build:worker --env preview && opennextjs-cloudflare preview --env preview",
    "deploy": "bun run build:worker && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "bun run cf-typegen && next typegen && tsc --noEmit",
    "test": "bun test src"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@local-craftsmen/contracts": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@local-craftsmen/config": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.13",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  },
  "trustedDependencies": []
}
