{
  "name": "local-craftsmen",
  "version": "1.2.13",
  "private": true,
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/client": "^1.16.2",
      "@orpc/contract": "^1.16.2",
      "@orpc/openapi": "^1.16.2",
      "@orpc/openapi-client": "^1.16.2",
      "@orpc/server": "^1.16.2",
      "@types/bun": "^1.4.4",
      "@types/node": "^26.6.6",
      "better-auth": "^1.7.18",
      "drizzle-orm": "^0.45.4",
      "tsrs": "0.23.0-ts7.1.0-beta",
      "typescript": "^7.0.2",
      "wrangler": "^4.159.0",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "preview": "turbo run preview",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint-fix": "biome check --write . && biome check --write --vcs-use-ignore-file=false --no-errors-on-unmatched packages/maintain",
    "web:dev": "bun run --cwd apps/web dev",
    "api:dev": "bun run --cwd apps/api dev",
    "db:up": "podman compose up -d",
    "db:down": "podman compose down",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:migrate:preview": "bun run --cwd packages/db db:migrate:preview",
    "db:migrate:production": "bun run --cwd packages/db db:migrate:production",
    "db:seed:reference": "bun run --cwd packages/db db:seed:reference",
    "db:seed:reference:preview": "bun run --cwd packages/db db:seed:reference:preview",
    "db:seed:reference:production": "bun run --cwd packages/db db:seed:reference:production",
    "db:clear": "bun run --cwd packages/db db:clear"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "tsrs": "catalog:",
    "turbo": "^2.11.10"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "vitest": "^5.1.0"
  },
  "trustedDependencies": []
}
